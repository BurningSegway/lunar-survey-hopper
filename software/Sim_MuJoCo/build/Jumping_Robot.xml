<mujoco model="directional_jumper_final">
  <compiler angle="degree"/>
  
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <default>
    <geom contype="1" conaffinity="1" friction="1 0.1 0.1"/>
    
    <!-- Forces the engine to respect the ctrlrange limits on your actuators -->
    <motor ctrllimited="true"/>
    
    <default class="shock_absorber">
      <joint type="slide" axis="0 0 1" range="0 0.12" stiffness="1500" damping="150" springref="0" limited="true"/>
      <geom type="capsule" size="0.015" mass="0.05" rgba="0.4 0.4 0.4 1"/>
    </default>
  </default>

  <asset>
    <!-- Moon surface, 100 x 100 m; generated by build/convert_usd.py -->
    <mesh name="terrain_mesh" file="terrain.obj"/>
    <!-- Scan target (Stanford Bunny, 1.5 m in the OBJ, scaled to 0.3 m tall,
         base at z=0); placed at the
         track target by the simulator. -->
    <mesh name="target_mesh" file="target_bunny.obj" scale="0.2 0.2 0.2"/>
    <hfield name="terrain_heightfield" file="terrain_height.bin"
            size="49.8762 49.8762 4.9554 0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="terrain_visual" type="mesh" mesh="terrain_mesh" pos="0 0 0"
          contype="0" conaffinity="0" rgba="0.45 0.5 0.4 1"/>
    <!-- group 2: the terrain the downward lidar sees (with the target object) -->
    <!-- Ground contact. priority="1" makes these settings apply to the legs and
         body (the jumping foot overrides them with its own, priority 2):
         - solref 0.005 s / damping ratio 1.5: firm and overdamped, so landings
           neither bounce nor sink in. The earlier sand-like 0.03 s / solimp
           0.6 let Moon landings (~7 m/s) push the legs 8-17 cm and the body
           up to 9 cm into the ground, where legs could stay stuck;
         - solimp 0.9 -> 0.95 over 1 cm;
         - friction 0.7: dry sand (angle of repose ~35 deg). -->
    <geom name="terrain_collision" type="hfield" hfield="terrain_heightfield"
          pos="0 0 -0.2871" group="2"
          friction="0.7 0.01 0.001" priority="1" solref="0.005 1.5" solimp="0.9 0.95 0.01 0.5 2"/>

    <!-- Scan target: moved onto the terrain at --track-target by the
         simulator, parked out of sight below the terrain otherwise. The
         lidar sees it (MeshRayCaster); the robot collides with its convex hull. -->
    <geom name="target_object" type="mesh" mesh="target_mesh" pos="0 0 0"
          rgba="1 0.45 0 1"/>  <!-- bright orange -->

    <body name="base_link" pos="0 0 0.2875">
      <freejoint name="root"/>
      
      <!-- IMU at the body origin (accelerometer used for ascent/descent detection) -->
      <site name="imu" pos="0 0 0" size="0.01"/>

      <!-- 30 cm cube. Mass and inertia (and the wheels' inertias) are fitted by
           build/fit_robot_model.py to jumper_sim/cube_model.py (CAD J_c,
           J_w,i; 3.3 kg cube placeholder + four 224 g jump springs): the whole
           robot in flight is exactly 4.196 kg and diag(J_c) about its CoM.
           Rerun the script instead of editing these by hand. -->
      <inertial pos="0 0 0" mass="3.196" fullinertia="0.0396424837 0.0396524837 0.0482262792 -0.000148951382 0.000227895615 0.000227895615"/>
      <geom name="body_box" type="box" size="0.15 0.15 0.15" rgba="0.2 0.6 0.8 0.8"/>

      <!-- LIDAR (Livox Mid-360S, 65x65x60 mm) on the +x side face, flush with
           the bottom. Its rotation axis is the site's -z axis: pointing out of
           the face, tilted 22.5 deg down, so straight down (body -z) is in the
           middle of its -7..52 deg band and it can look straight at the target
           with the robot's bottom. The blind cone (38 deg around that axis)
           points out and slightly down from this face. -->
      <site name="lidar" pos="0.185 0 -0.1175" euler="0 -67.5 0" size="0.03" rgba="0.1 0.1 0.1 1"/>

      <!-- REACTION WHEELS (Housed inside the box on their respective axes) -->
      <body name="rw_x" pos="0.125 0 0">
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.004422 0.002211 0.002211"/>
        <joint name="rw_x_joint" type="hinge" axis="1 0 0" damping="0.01"/>
        <geom name="rw_x_geom" type="cylinder" size="0.08 0.02" euler="0 90 0"
              contype="0" conaffinity="0" rgba="0.8 0.2 0.2 1"/>
      </body>
      
      <body name="rw_y" pos="0 0.125 0">
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.002211 0.004422 0.002211"/>
        <joint name="rw_y_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom name="rw_y_geom" type="cylinder" size="0.08 0.02" euler="90 0 0"
              contype="0" conaffinity="0" rgba="0.2 0.8 0.2 1"/>
      </body>
      
      <body name="rw_z" pos="0 0 0.125">
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.002211 0.002211 0.004422"/>
        <joint name="rw_z_joint" type="hinge" axis="0 0 1" damping="0.01"/>
        <geom name="rw_z_geom" type="cylinder" size="0.08 0.02"
              contype="0" conaffinity="0" rgba="0.8 0.8 0.2 1"/>
      </body>

      <!-- MOVABLE SHOCK ABSORBER LEGS -->
      <body name="leg_fl" pos="0.12 0.12 -0.15">
        <joint name="shock_fl" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0  0.075 0.075 -0.1125"/>
      </body>
      <body name="leg_fr" pos="0.12 -0.12 -0.15">
        <joint name="shock_fr" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0  0.075 -0.075 -0.1125"/>
      </body>
      <body name="leg_bl" pos="-0.12 0.12 -0.15">
        <joint name="shock_bl" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0 -0.075 0.075 -0.1125"/>
      </body>
      <body name="leg_br" pos="-0.12 -0.12 -0.15">
        <joint name="shock_br" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0 -0.075 -0.075 -0.1125"/>
      </body>

      <!-- CENTRAL JUMPING FOOT
           Four compression springs in parallel (fjedre.dk 13760, JUMP_SPRING in
           jumper_sim/cube_model.py; joint, foot position and spawn height
           written by build/fit_robot_model.py): q = 0 is wound to full
           compression (257 mm, 1718 N, 221 J) with the foot at the bottom of
           the cube; the range ends at the springs' free length (spring length
           and placement are not modelled). Light damping, stiff stroke
           limits, a third of the springs' mass moving with the foot
           (armature). The wind-up motor (JUMP_WINDUP_FORCE in simulation.py)
           holds the foot at q = 0 with 1.25x the wound force.
           Firm foot contact: priority="2" overrides the soft sand for the foot
           only (legs and body still land in sand). In the sand the foot sank in
           and was ejected, so the jump height depended on the spot (0.01-8.8 m
           on Earth); with the firm foot it varies only with the local terrain
           (+-20 %). Friction matches the sand.
           Spherical foot (bottom where the old 1 cm cylinder's was): a flat
           cylinder on flat ground touches at one rim point, so the push was
           off-centre and spun the robot up to 18 rad/s at take-off; the sphere
           pushes through its centre (0.2-0.9 rad/s). -->
      <body name="central_foot" pos="0 0 -0.14">
        <joint name="jump_joint" type="slide" axis="0 0 -1" stiffness="6680" damping="2" springref="0.2572" limited="true" range="0 0.2572" solreflimit="0.002 1" armature="0.298667"/>
        <geom name="foot" type="sphere" size="0.04" pos="0 0 0.03" mass="0.2" rgba="0.9 0.5 0.1 1"
              priority="2" solref="0.002 1" friction="0.7 0.01 0.001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="wind_up_motor" joint="jump_joint" gear="1" ctrlrange="-13000 13000"/>
    <motor name="motor_rw_x" joint="rw_x_joint" gear="1" ctrlrange="-20 20"/>
    <motor name="motor_rw_y" joint="rw_y_joint" gear="1" ctrlrange="-20 20"/>
    <motor name="motor_rw_z" joint="rw_z_joint" gear="1" ctrlrange="-20 20"/>
    
    <!-- TILT MOTORS: shorten a leg against its shock spring, to lean towards a
         far target before jumping (jump_aim.py). -->
    <motor name="tilt_fl" joint="shock_fl" gear="1" ctrlrange="-1000 1000"/>
    <motor name="tilt_fr" joint="shock_fr" gear="1" ctrlrange="-1000 1000"/>
    <motor name="tilt_bl" joint="shock_bl" gear="1" ctrlrange="-1000 1000"/>
    <motor name="tilt_br" joint="shock_br" gear="1" ctrlrange="-1000 1000"/>
  </actuator>

  <sensor>
    <!-- Corrected sensor tags for MuJoCo -->
    <framequat name="robot_orientation" objtype="body" objname="base_link"/>
    <frameangvel name="robot_gyro" objtype="body" objname="base_link"/>
    <!-- For logging only: the simulator's ascent/descent detection uses the
         body's velocity change per step instead (see simulation.py). -->
    <accelerometer name="imu_accel" site="imu"/>
  </sensor>
</mujoco>
