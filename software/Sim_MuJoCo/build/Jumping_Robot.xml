<mujoco model="directional_jumper_final">
  <compiler angle="degree"/>
  
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <default>
    <geom contype="1" conaffinity="1" friction="1 0.1 0.1"/>
    
    <!-- FIX 1: This forces the physics engine to respect the ctrlrange limits on your actuators -->
    <motor ctrllimited="true"/>
    
    <default class="shock_absorber">
      <joint type="slide" axis="0 0 1" range="0 0.12" stiffness="1500" damping="150" springref="0" limited="true"/>
      <geom type="capsule" size="0.015" mass="0.05" rgba="0.4 0.4 0.4 1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.9 0.8 1" friction="1 0.5 0.1"/>

    <body name="base_link" pos="0 0 0.25">
      <freejoint name="root"/>
      
      <!-- FIX 2: Explicitly defined 5.0 kg box with 0.12 kg/m2 inertia -->
      <inertial pos="0 0 0" mass="5.0" diaginertia="0.12 0.12 0.12"/>
      <geom name="body_box" type="box" size="0.1 0.1 0.1" rgba="0.2 0.6 0.8 0.8"/>

      <!-- REACTION WHEELS -->
      <body name="rw_x" pos="0 0 0">
        <!-- FIX 3: Explicitly defined 200g mass with 0.0036 kg/m2 inertia -->
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.0036 0.0036 0.0036"/>
        <joint name="rw_x_joint" type="hinge" axis="1 0 0" damping="0.01"/>
        <geom type="cylinder" size="0.08 0.02" rgba="0.8 0.2 0.2 1"/>
      </body>
      <body name="rw_y" pos="0 0 0">
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.0036 0.0036 0.0036"/>
        <joint name="rw_y_joint" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom type="cylinder" size="0.08 0.02" euler="90 0 0" rgba="0.2 0.8 0.2 1"/>
      </body>
      <body name="rw_z" pos="0 0 0">
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.0036 0.0036 0.0036"/>
        <joint name="rw_z_joint" type="hinge" axis="0 0 1" damping="0.01"/>
        <geom type="cylinder" size="0.08 0.02" euler="0 90 0" rgba="0.8 0.8 0.2 1"/>
      </body>

      <!-- MOVABLE SHOCK ABSORBER LEGS -->
      <body name="leg_fl" pos="0.08 0.08 -0.1">
        <joint name="shock_fl" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0  0.1 0.1 -0.15"/>
      </body>
      <body name="leg_fr" pos="0.08 -0.08 -0.1">
        <joint name="shock_fr" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0  0.1 -0.1 -0.15"/>
      </body>
      <body name="leg_bl" pos="-0.08 0.08 -0.1">
        <joint name="shock_bl" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0 -0.1 0.1 -0.15"/>
      </body>
      <body name="leg_br" pos="-0.08 -0.08 -0.1">
        <joint name="shock_br" class="shock_absorber"/>
        <geom type="capsule" class="shock_absorber" fromto="0 0 0 -0.1 -0.1 -0.15"/>
      </body>

      <!-- CENTRAL JUMPING FOOT -->
      <body name="central_foot" pos="0 0 -0.10">
        <joint name="jump_joint" type="slide" axis="0 0 -1" stiffness="20000" damping="100" springref="0.3" limited="true" range="-0.02 0.4" armature="0.1"/>
        <geom type="cylinder" size="0.04 0.01" mass="0.2" rgba="0.9 0.5 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="wind_up_motor" joint="jump_joint" gear="1" ctrlrange="-8000 8000"/>
    <motor name="motor_rw_x" joint="rw_x_joint" gear="1" ctrlrange="-20 20"/>
    <motor name="motor_rw_y" joint="rw_y_joint" gear="1" ctrlrange="-20 20"/>
    <motor name="motor_rw_z" joint="rw_z_joint" gear="1" ctrlrange="-20 20"/>
    
    <!-- TILT MOTORS -->
    <motor name="tilt_fl" joint="shock_fl" gear="1" ctrlrange="-1000 1000"/>
    <motor name="tilt_fr" joint="shock_fr" gear="1" ctrlrange="-1000 1000"/>
  </actuator>
</mujoco>